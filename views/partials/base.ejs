<style>
  /* Adjust main content to avoid overlapping with header and sidebar */
  .main-content {
    margin-top: 70px; /* Adjust based on your header height */
    padding-bottom: 100px;
  }

  .loading-indicator {
    text-align: center;
    margin-top: 20px;
    font-size: 18px;
    color: #007bff;
  }

  .no-data {
    text-align: center;
    margin-top: 20px;
    font-size: 18px;
    color: #ff0000;
  }

  #notificationArea {
    position: fixed;
    top: 40px;
    right: 20px;
    z-index: 9999;
    min-width: 300px;
    padding: 10px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    border-radius: 5px;
  }

  @media (min-width: 1000px) {
    .main-content {
      padding-left: 0; /* No padding for small screens */
    }
  }
</style>
