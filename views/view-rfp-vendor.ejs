<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Apply for RFP</title>

    <!-- Include CSS and other dependencies -->
    <%- include('partials/base.ejs') %>
  </head>
  <body data-sidebar="dark">
    <!-- Include Header -->
    <%- include('partials/headers.ejs') %>

    <!-- Include Sidebar -->
    <%- include('partials/sidebars.ejs') %>

    <!-- Main Content Starts Here -->
    <div id="notificationArea" class="alert d-none"></div>
    <div class="main-content">
      <div class="container">
        <div class="row">
          <div class="col">
            <h1 class="mb-5">Apply for RFP</h1>
            <form id="applyRfpForm">
              <!-- Name -->
              <div class="form-group">
                <label for="itemName">Item Name</label>
                <input
                  type="text"
                  step="0.01"
                  id="itemName"
                  name="item_name"
                  class="form-control"
                  disabled
                />
                <span id="error_itemName" class="text-danger"></span>
              </div>

              <!-- Description -->
              <div class="form-group">
                <label for="itemDescription">Item Description</label>
                <input
                  type="text"
                  step="0.01"
                  id="itemDescription"
                  name="item_description"
                  class="form-control"
                  disabled
                />
                <span id="error_itemDescription" class="text-danger"></span>
              </div>

              <!-- RFP Status -->
              <div class="form-group">
                <label for="RfpStatus">RFP Status</label>
                <input
                  type="text"
                  step="0.01"
                  id="rfpStatus"
                  name="rfp_status"
                  class="form-control"
                  disabled
                />
                <span id="error_rfpStatus" class="text-danger"></span>
              </div>

              <!-- Min Price -->
              <div class="form-group">
                <label for="itemMinPrice">Min Price</label>
                <input
                  type="number"
                  step="0.01"
                  id="itemMinPrice"
                  name="item_min_price"
                  class="form-control"
                  disabled
                />
                <span id="error_itemMinPrice" class="text-danger"></span>
              </div>

              <!-- Max Price -->
              <div class="form-group">
                <label for="itemMaxPrice">Max Price</label>
                <input
                  type="number"
                  step="0.01"
                  id="itemMaxPrice"
                  name="item_max_price"
                  class="form-control"
                  disabled
                />
                <span id="error_itemMaxPrice" class="text-danger"></span>
              </div>

              <!-- Status -->
              <div class="form-group">
                <label for="itemStatus">Status</label>
                <input
                  type="text"
                  step="0.01"
                  id="itemStatus"
                  name="item_status"
                  class="form-control"
                  disabled
                />
                <span id="error_itemStatus" class="text-danger"></span>
              </div>

              <!-- Item Quantity -->
              <div class="form-group">
                <label for="itemQuantity">Quantity</label>
                <input
                  type="number"
                  step="0.01"
                  id="itemQuantity"
                  name="item_quantity"
                  class="form-control"
                  disabled
                />
                <span id="error_itemQuantity" class="text-danger"></span>
              </div>

              <!-- Item Price -->
              <div class="form-group">
                <label for="itemPrice">Item Price</label>
                <input
                  type="number"
                  step="0.01"
                  id="itemPrice"
                  name="item_price"
                  class="form-control"
                  disabled
                />
                <span id="error_itemPrice" class="text-danger"></span>
              </div>

              <!-- Total Cost -->
              <div class="form-group">
                <label for="totalCost">Total Cost</label>
                <input
                  type="number"
                  step="0.01"
                  id="totalCost"
                  name="total_cost"
                  class="form-control"
                  disabled
                />
                <span id="error_totalCost" class="text-danger"></span>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>

    <!-- Include Footer -->
    <%- include('partials/footer.ejs') %>

    <script>
      $(document).ready(function () {
        const max_price = "<%= rfp.max_price %>";
        const min_price = "<%= rfp.min_price %>";
        const quantity = "<%= rfp.quantity %>";
        const name = "<%= rfp.name %>";
        const description = "<%= rfp.description %>";
        const item_price = "<%= rfp.item_price %>";
        const total_price = "<%= rfp.total_cost %>";
        const status = "<%= rfp.status %>";
        const rfpStatus = "<%= rfp.rfp_status %>";
        const applyRfpForm = $("#applyRfpForm");
        const notificationArea = $("#notificationArea");
        
        // Set RFP details
        $("#itemName").val(name);
        $("#itemDescription").val(description);
        $("#itemMinPrice").val(min_price);
        $("#itemMaxPrice").val(max_price);
        $("#itemQuantity").val(quantity);
        $("#itemPrice").val(item_price);
        $("#totalCost").val(total_price);
        $("#itemStatus").val(status);
        $("#rfpStatus").val(rfpStatus);
      });
    </script>
  </body>
</html>
