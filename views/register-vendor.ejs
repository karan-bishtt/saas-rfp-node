<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Register | RFP System</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      content="Premium Multipurpose Admin & Dashboard Template"
      name="description"
    />
    <meta content="Themesbrand" name="author" />

    <!-- App favicon -->
    <link rel="shortcut icon" href="images/favicon.ico" />

    <!-- Bootstrap Css -->
    <link
      href="css/bootstrap.min.css"
      id="bootstrap-style"
      rel="stylesheet"
      type="text/css"
    />
    <!-- Icons Css -->
    <link href="css/icons.min.css" rel="stylesheet" type="text/css" />
    <!-- App Css-->
    <link
      href="css/app.min.css"
      id="app-style"
      rel="stylesheet"
      type="text/css"
    />

    <!-- jQuery -->
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
  </head>

  <body>
    <div class="home-btn d-none d-sm-block">
      <a href="#" class="text-dark"><i class="fas fa-home h2"></i></a>
    </div>
    <div class="account-pages my-5 pt-sm-5">
      <div class="container">
        <div class="row justify-content-center">
          <div class="col-md-8 col-lg-6 col-xl-8">
            <div class="card overflow-hidden">
              <div class="bg-soft-primary">
                <div class="row">
                  <div class="col-12">
                    <div class="text-primary p-4">
                      <h5 class="text-primary">Welcome to RFP System!</h5>
                      <p>Register as Vendor</p>
                    </div>
                  </div>
                </div>
              </div>
              <div class="card-body pt-0">
                <div class="p-4">
                  <form id="registrationForm" class="form-horizontal">
                    <!-- Error Message -->
                    <div id="error_message" class="alert alert-danger d-none">
                      <span></span>
                    </div>

                    <!-- Success Message -->
                    <div
                      id="success_message"
                      class="alert alert-primary d-none"
                    >
                      <span></span>
                    </div>

                    <div class="row">
                      <!-- First Name -->
                      <div class="col-md-12 col-lg-6">
                        <div class="form-group">
                          <label for="firstname">First Name*</label>
                          <input
                            type="text"
                            class="form-control"
                            name="firstname"
                            id="firstname"
                            placeholder="Enter First Name"
                          />
                          <span id="error_firstname" class="text-danger"></span>
                        </div>
                      </div>
                      <!-- Last Name -->
                      <div class="col-md-12 col-lg-6">
                        <div class="form-group">
                          <label for="lastname">Last Name</label>
                          <input
                            type="text"
                            class="form-control"
                            name="lastname"
                            id="lastname"
                            placeholder="Enter Last Name"
                          />
                          <span id="error_lastname" class="text-danger"></span>
                        </div>
                      </div>

                      <!-- Company Name -->
                      <div class="col-md-12 col-lg-6">
                        <div class="form-group">
                          <label for="company_name">Select Company*</label>
                          <select
                            class="form-control"
                            name="tenant_id"
                            id="tenant_id"
                          >
                            <option value="">Select Company</option>
                            <!-- Default Option -->
                          </select>
                          <span id="error_tenant_id" class="text-danger"></span>
                        </div>
                      </div>

                      <!-- Category Name -->
                      <div class="col-md-12 col-lg-6">
                        <div class="form-group">
                          <label for="category">Category Name*</label>
                          <select
                            class="form-control"
                            name="category"
                            id="category"
                            multiple
                          >
                            <option value="">Select a company first</option>
                          </select>
                          <span id="error_category" class="text-danger"></span>
                        </div>
                      </div>

                      <!-- Email -->
                      <div class="col-md-12 col-lg-6">
                        <div class="form-group">
                          <label for="email">Email*</label>
                          <input
                            type="email"
                            class="form-control"
                            name="email"
                            id="email"
                            placeholder="Enter Email"
                          />
                          <span id="error_email" class="text-danger"></span>
                        </div>
                      </div>

                      <!-- Phone Number -->
                      <div class="col-md-12 col-lg-6">
                        <div class="form-group">
                          <label for="phone_number">Phone Number*</label>
                          <input
                            type="text"
                            class="form-control"
                            name="phone_number"
                            id="phone_number"
                            placeholder="Enter Phone Number"
                          />
                          <span
                            id="error_phone_number"
                            class="text-danger"
                          ></span>
                        </div>
                      </div>

                      <!-- Address -->
                      <div class="col-md-12">
                        <div class="form-group">
                          <label for="address">Address*</label>
                          <textarea
                            class="form-control"
                            name="address"
                            id="address"
                            placeholder="Enter Address"
                            rows="3"
                          ></textarea>
                          <span id="error_address" class="text-danger"></span>
                        </div>
                      </div>

                      <!-- GST No -->
                      <div class="col-md-12 col-lg-6">
                        <div class="form-group">
                          <label for="gst_no">GST No*</label>
                          <input
                            type="text"
                            class="form-control"
                            name="gst_no"
                            id="gst_no"
                            placeholder="Enter GST Number"
                          />
                          <span id="error_gst_no" class="text-danger"></span>
                        </div>
                      </div>

                      <!-- Revenue No -->
                      <div class="col-md-12 col-lg-6">
                        <div class="form-group">
                          <label for="revenue">Revenue No*</label>
                          <input
                            type="text"
                            class="form-control"
                            name="revenue"
                            id="revenue"
                            placeholder="Enter Revenue Number"
                          />
                          <span id="error_revenue" class="text-danger"></span>
                        </div>
                      </div>

                      <!-- no_of_employees No -->
                      <div class="col-md-12 col-lg-6">
                        <div class="form-group">
                          <label for="no_of_employees">No of Employee*</label>
                          <input
                            type="text"
                            class="form-control"
                            name="no_of_employees"
                            id="no_of_employees"
                            placeholder="Enter No of Employee"
                          />
                          <span
                            id="error_no_of_employees"
                            class="text-danger"
                          ></span>
                        </div>
                      </div>

                      <!-- pancard_no No -->
                      <div class="col-md-12 col-lg-6">
                        <div class="form-group">
                          <label for="pancard_no">Pancard No*</label>
                          <input
                            type="text"
                            class="form-control"
                            name="pancard_no"
                            id="pancard_no"
                            placeholder="Enter Pancard Number"
                          />
                          <span
                            id="error_pancard_no"
                            class="text-danger"
                          ></span>
                        </div>
                      </div>

                      <!-- Password -->
                      <div class="col-md-12 col-lg-6">
                        <div class="form-group">
                          <label for="password">Password*</label>
                          <input
                            type="password"
                            class="form-control"
                            name="password"
                            id="password"
                            placeholder="Enter Password"
                          />
                          <span id="error_password" class="text-danger"></span>
                        </div>
                      </div>

                      <!-- Confirm Password -->
                      <div class="col-md-12 col-lg-6">
                        <div class="form-group">
                          <label for="confirm_password"
                            >Confirm Password*</label
                          >
                          <input
                            type="password"
                            class="form-control"
                            name="confirm_password"
                            id="confirm_password"
                            placeholder="Confirm Password"
                          />
                          <span
                            id="error_confirm_password"
                            class="text-danger"
                          ></span>
                        </div>
                      </div>

                      <!-- Submit Button -->
                      <div class="col-md-12 mt-3">
                        <button
                          type="button"
                          id="register_button"
                          class="btn btn-primary btn-block waves-effect waves-light"
                        >
                          Register
                        </button>
                      </div>
                    </div>
                    <div class="mt-4 text-center">
                      <a href="<%= loginUrl %>" class="text-muted"
                        ><i class="mdi mdi-lock mr-1"></i> Login</a
                      >
                    </div>
                  </form>
                </div>
              </div>
            </div>
            <div class="mt-5 text-center">
              <p>
                &copy; Copyright <i class="mdi mdi-heart text-danger"></i> RFP
                System
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <script>
      $(document).ready(function () {
        // Fetch initial data (if required) and populate fields
        populateCompanyDropdown();

        // Form Submission registration
        $("#register_button").click(function () {
          // Clear error messages
          $(".text-danger").text("");
          $("#error_message").addClass("d-none").text("");
          $("#success_message").addClass("d-none").text("");

          // Gather form data
          const formData = {
            firstname: $("#firstname").val(),
            lastname: $("#lastname").val(),
            category: $("#category").val(),
            email: $("#email").val(),
            mobile: $("#phone_number").val(),
            address: $("#address").val(),
            gst_no: $("#gst_no").val(),
            revenue: $("#revenue").val(),
            no_of_employees: $("#no_of_employees").val(),
            pancard_no: $("#pancard_no").val(),
            password: $("#password").val(),
            confirm_password: $("#confirm_password").val(),
            tenant_id: $("#tenant_id").val(),
          };

          let isValid = true;

          // Validate form fields
          for (const [key, value] of Object.entries(formData)) {
            // Check if value is an array and ensure it has elements
            if (Array.isArray(value) && value.length === 0) {
              $(`#error_${key}`).text(`${key.replace("_", " ")} is required.`);
              isValid = false;
            }
            // Check if value is a number or string and ensure it's not empty
            else if (
              (typeof value === "string" && !value.trim()) ||
              (typeof value === "number" && isNaN(value))
            ) {
              if (key === "tenant_id") {
                $(`#error_${key}`).text("Company is required.");
              } else {
                $(`#error_${key}`).text(
                  `${key.replace("_", " ")} is required.`
                );
              }
              isValid = false;
            }
          }

          if (formData.password !== formData.confirm_password) {
            $("#error_confirm_password").text("Passwords do not match.");
            isValid = false;
          }

          // Stop submission if validation fails
          if (!isValid) {
            return;
          }

          // Send AJAX request
          $.ajax({
            url: "/api/register-vendor",
            type: "POST",
            data: JSON.stringify(formData),
            contentType: "application/json",
            success: function (response) {
              if (response.status) {
                $("#success_message")
                  .removeClass("d-none")
                  .text(response.message);

                setTimeout(() => {
                  window.location.href = "/";
                }, 1000);
              } else {
                // Display errors
                $("#error_message")
                  .removeClass("d-none")
                  .text(response.message);
              }
            },
            beforeSend: function () {
              // Disable button and show loading state
              $("#register_button").prop("disabled", true).text("Loading...");
            },
            error: function (xhr) {
              const errorMessage =
                xhr.responseJSON?.message ||
                "An error occurred. Please try again.";
              $("#error_message").removeClass("d-none").text(errorMessage);
              $("#success_message").addClass("d-none").text("");
            },
            complete: function () {
              // Re-enable button and reset text
              $("#register_button").prop("disabled", false).text("Register");
            },
          });
        });

        /**
         * Fetches companies from the API and populates the company dropdown
         */
        function populateCompanyDropdown() {
          const companyDropdown = $("#tenant_id");
          $.ajax({
            url: "/api/tenants", // Replace with your actual API endpoint
            type: "GET",
            beforeSend: function () {
              // Show a loading message in the dropdown
              companyDropdown.html(
                '<option value="">Loading companies...</option>'
              );
              companyDropdown.prop("disabled", true);
            },
            success: function (response) {
              if (
                response.status &&
                response?.data?.tenants &&
                Object.keys(response.data.tenants)?.length > 0
              ) {
                // Clear existing options
                companyDropdown.find("option").remove();
                // Add default option
                companyDropdown.append(
                  '<option value="">Select Company</option>'
                );

                // Populate options
                Object.values(response.data.tenants).forEach((company) => {
                  companyDropdown.append(
                    `<option value="${company.id}">${company.name}</option>`
                  );
                });

                companyDropdown.prop("disabled", false);
              } else {
                // Show no data message
                companyDropdown.find("option").remove();
                companyDropdown.append(
                  '<option value="">No Company is registered yet</option>'
                );
                companyDropdown.prop("disabled", true);
              }
            },
            error: function () {
              // Show a loading message in the dropdown
              companyDropdown.html('<option value="">Select Company</option>');
              companyDropdown.prop("disabled", true);
              $("#error_message")
                .removeClass("d-none")
                .text("An error occurred. Please try again.");
            },
          });
        }

        // Handle tenant selection change
        $("#tenant_id").change(function () {
          const tenantId = $(this).val();

          if (tenantId) {
            // Fetch categories based on selected tenant
            fetchCategories(tenantId);
          } else {
            // Clear category field if no tenant is selected
            clearCategoryField();
          }
        });

        /**
         * Fetches categories for the selected tenant
         * @param {string} tenantId
         */
        function fetchCategories(tenantId) {
          const categoryField = $("#category");
          $.ajax({
            url: `/api/category?tenant_id=${tenantId}`, // Replace with your actual API endpoint
            type: "GET",
            beforeSend: function () {
              // Disable category field and show loading
              categoryField.prop("disabled", true);
              categoryField.html(
                '<option value="">Loading categories...</option>'
              );
            },
            success: function (response) {
              if (
                response.status &&
                response?.data?.categories &&
                Object.keys(response.data.categories)?.length > 0
              ) {
                // Clear existing options
                categoryField.find("option").remove();

                Object.values(response.data.categories).forEach((category) => {
                  categoryField.append(
                    `<option value="${category.id}">${category.name}</option>`
                  );
                });
                categoryField.prop("disabled", false);
              } else {
                // Show no data message
                categoryField.find("option").remove();
                categoryField.append(
                  '<option value="">No categories available</option>'
                );
                categoryField.prop("disabled", true);
              }
            },
            error: function () {
              categoryField.find("option").remove();
              categoryField.append(
                '<option value="">An error occurred. Please try again.</option>'
              );
              categoryField.prop("disabled", true);
            },
          });
        }

        /**
         * Handles changes in the category field
         * @param {Array} selectedCategories
         */
        function handleCategoryChange(selectedCategories) {
          console.log("Selected Categories:", selectedCategories);
          // Implement any logic you need when categories change
        }

        /**
         * Clears the category field
         */
        function clearCategoryField() {
          const categoryField = $("#category");
          categoryField.find("option").remove();
          categoryField.append(
            '<option value="">Select a company first</option>'
          );
          categoryField.prop("disabled", true);
        }
      });
    </script>
  </body>
</html>
